{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering-harness.dev/schemas/task/v1",
  "title": "Harness Task v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "objective", "acceptanceCriteria"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "context": { "type": "array", "items": { "type": "string" }, "default": [] },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonGoals": { "type": "array", "items": { "type": "string" }, "default": [] },
    "constraints": { "type": "array", "items": { "type": "string" }, "default": [] },
    "deliverables": { "type": "array", "items": { "type": "string" }, "default": [] },
    "verification": { "type": "array", "items": { "type": "string" }, "default": [] },
    "riskLevel": { "enum": ["low", "medium", "high"], "default": "medium" }
  }
}

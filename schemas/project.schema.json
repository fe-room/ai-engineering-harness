{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering-harness.dev/schemas/project/v1",
  "title": "Harness Project v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "knowledge", "commands", "skills", "adapters", "policies"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 } }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint", "documents"],
      "properties": {
        "entrypoint": { "type": ["string", "null"] },
        "documents": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verify"],
      "properties": {
        "verify": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "skills": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skillDirectories"],
      "properties": {
        "skillDirectories": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvalRequired"],
      "properties": {
        "approvalRequired": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}

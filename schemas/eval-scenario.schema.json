{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering-harness.dev/schemas/eval-scenario/v1",
  "title": "Harness Eval Scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "skill", "prompt", "expectations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "skill": { "type": "string", "minLength": 1 },
    "prompt": { "type": "string", "minLength": 1 },
    "expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceMode", "requiredBehaviors", "prohibitedBehaviors"],
      "properties": {
        "workspaceMode": { "enum": ["read-only", "read-write"] },
        "requiredBehaviors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "prohibitedBehaviors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
